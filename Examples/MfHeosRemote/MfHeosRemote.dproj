<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{CA2EB0B7-0D20-4FA0-AE87-585AF1BBE227}</ProjectGuid>
        <MainSource>MfHeosRemote.dpr</MainSource>
        <ProjectName>MfHeosRemote</ProjectName>
        <ProjectVersion>15.4</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <AppType>Application</AppType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>3</TargetedPlatforms>
        <DCC_UnitSearchPath>..\..\Source;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>System;Winapi;Vcl;$(DCC_Namespace)</DCC_Namespace>
        <DCC_ExeOutput>..\..\Build\$(Platform)</DCC_ExeOutput>
        <DCC_DcuOutput>..\..\Build\$(Platform)</DCC_DcuOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug'">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_DebugInformation>1</DCC_DebugInformation>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release'">
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
        <DCCReference Include="frmHeosRemote.pas"><Form>HeosRemoteFrm</Form></DCCReference>
        <DCCReference Include="..\..\Source\Heos.Cli.pas"/>
        <DCCReference Include="..\..\Source\Heos.Commands.pas"/>
        <DCCReference Include="..\..\Source\Heos.Sockets.pas"/>
        <BuildConfiguration Include="Base"><Key>Base</Key></BuildConfiguration>
        <BuildConfiguration Include="Debug"><Key>Cfg_1</Key><CfgParent>Base</CfgParent></BuildConfiguration>
        <BuildConfiguration Include="Release"><Key>Cfg_2</Key><CfgParent>Base</CfgParent></BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Delphi.Personality>
                <Source><Source Name="MainSource">MfHeosRemote.dpr</Source></Source>
            </Delphi.Personality>
            <Platforms><Platform value="Win32">True</Platform><Platform value="Win64">True</Platform></Platforms>
        </BorlandProject>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets"/>
</Project>